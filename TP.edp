load "Element_P4"

// Import python
mesh Th1 = readmesh("data/mesh.msh");
plot(Th1, wait=true, cmm="Maillage Python");
fespace Vh1(Th1, P1);
Vh1 S;
ifstream fileUh("data/S.txt");
fileUh >> S[];
Vh1 A;
ifstream fileA("data/A.txt");
fileA >> A[];

// Paramètres
real k = 10*pi;
real a = 3.0;
real R = 1;

// Frontière objet
border C(t=0, 2*pi){x=R*cos(t); y=R*sin(t); label=1; }

// Frontière extérieure
border sq1(t=0, 1){x=-a+2*a*t; y=-a      ; label=2; }
border sq2(t=0, 1){x=a       ; y=-a+2*a*t; label=2; }
border sq3(t=0, 1){x=a-2*a*t ; y=a       ; label=2; }
border sq4(t=0, 1){x=-a      ; y=a-2*a*t ; label=2; }

// Maillage
real lambda = 2*pi/k;
real h      = lambda/4;
int nC      = int(2*pi*R/h);     
int nSq     = int(2*a/h);        

mesh Th2 = buildmesh(sq1(nSq) + sq2(nSq) + sq3(nSq) + sq4(nSq) + C(-nC));
plot(Th2, wait=true, cmm="Maillage FreeFEM++");

// -----------------------------------------------------------------------------
// [CONSEIL 5 du PDF] : Réduire l'effet de pollution avec des éléments d'ordre 4.
// On change P2 en P4 pour avoir une solution de référence très précise.
// -----------------------------------------------------------------------------
fespace Vh2(Th2, P4);

// 1. On définit vh sur le maillage Python Th1 en premier
Vh1<complex> vh1 = A * exp(1i*k*S); 

// 3. On crée le champ sur le maillage final Th2
Vh2<complex> vh;
vh = (x > 0 && abs(y) < 1.0) ? -exp(1i*k*x) : vh1;

Vh2 vhReel = real(vh1);

plot(vhReel, value=true, wait=true, fill=true, nbiso=30, cmm="Partie reelle du champ diffracte OG");


// PML
real R0       = 1.75;
real sigmaMax = 5.0;

func real sigma(real r) {
  if (r <= R0) { return 0.0; } 
  else { return sigmaMax * (r - R0)^2; }
}

func real dsigma(real r) {
  if (r <= R0) { return 0.0; } 
  else { return sigmaMax * 2 * (r - R0); }
}

macro r() (sqrt(x^2 + y^2)) //
macro alpha() (1.0 + 1i * sigma(r)) //
macro beta() (alpha + 1i * r * dsigma(r)) //

macro A11() (beta/alpha + (alpha/beta - beta/alpha)*x*x/(r*r)) //
macro A12() (0          + (alpha/beta - beta/alpha)*x*y/(r*r)) //
macro A21() (0          + (alpha/beta - beta/alpha)*y*x/(r*r)) //
macro A22() (beta/alpha + (alpha/beta - beta/alpha)*y*y/(r*r)) //


// Question 4
Vh2<complex> u, v;

problem HelmholtzPML(u, v)
  = int2d(Th2, qforder=9)( // quadrature plus élevée pour éléments P4
    (1.0/k^2) * (
      A11 * dx(u) * dx(v) + A12 * dx(u) * dy(v) +
      A21 * dy(u) * dx(v) + A22 * dy(u) * dy(v)
    )
    - alpha * beta * u * v
  )
  + on(1, u=-exp(1i * k * x));

HelmholtzPML;

Vh2 uReel = real(u);
plot(uReel, value=true, wait=true, fill=true, nbiso=30, cmm="Partie reelle du champ diffracte FreeFEM++ (PML)");


// Question 5
Vh2 udiff = abs(u - vh)*(r <= R0);
plot(udiff, fill=true, value=true, cmm="Erreur absolue entre OG et PML (Visuelle)");


// Question 6
border physBound(t=0, 2*pi){x=R0*cos(t); y=R0*sin(t); label=3;} 

// maillage fin
real hErr = h / 2.0;
int nPhys = int(2*pi*R0 / hErr);
int nCErr = int(2*pi*R / hErr);

mesh ThPhys = buildmesh(physBound(nPhys) + C(-nCErr));

// élément P1 pour calculer l'erreur
fespace VhPhys(ThPhys, P1);

VhPhys<complex> uPhys = u; 
VhPhys<complex> vhPhys = (x > 0 && abs(y) < 1.0) ? -exp(1i*k*x) : vh1;

// calcul de l'erreur L2
real errL2 = sqrt(int2d(ThPhys)( abs(uPhys - vhPhys)^2 ));
real normL2 = sqrt(int2d(ThPhys)( abs(uPhys)^2 ));
real errRelative = errL2 / normL2;

cout << "\n=======================================================" << endl;
cout << " ANALYSE D'ERREUR POUR k = " << k << " (ATTENDU 2 DU PROJET)" << endl;
cout << "=======================================================" << endl;
cout << " Erreur absolue L2 (domaine physique) : " << errL2 << endl;
cout << " Erreur relative L2 : " << errRelative << endl;
cout << "=======================================================\n" << endl;